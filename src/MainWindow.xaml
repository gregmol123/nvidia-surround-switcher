<Window x:Class="ScreenSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Switcher"
        Icon="icon.ico"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextMain}"
        Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded" Activated="Window_Activated">

    <Window.Resources>
        <Style x:Key="ModeCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="2" CornerRadius="10" Padding="14,18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextDim}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActive}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Screen" TargetType="Border">
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock x:Name="CurrentText" FontSize="14" Margin="2,0,0,14" Text="Reading the screen layout…"/>

        <Grid x:Name="Cards">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SurroundCard" Style="{StaticResource ModeCard}" Click="SurroundCard_Click" AutomationProperties.Name="Surround">
                <StackPanel>
                    <Border Style="{StaticResource Screen}" Width="124" Background="{StaticResource CardActive}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Surround"/>
                    <TextBlock Style="{StaticResource CardNote}" Text="for games"/>
                </StackPanel>
            </Button>

            <Button x:Name="ExtendedCard" Grid.Column="2" Style="{StaticResource ModeCard}" Click="ExtendedCard_Click" AutomationProperties.Name="Extended">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Screen}" Width="58" Margin="0,0,8,0"/>
                        <Border Style="{StaticResource Screen}" Width="58"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Extended"/>
                    <TextBlock Style="{StaticResource CardNote}" Text="for programs"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Margin="2,14,0,0"
                   Foreground="{StaticResource TextDim}"
                   Text="Ctrl+Alt+F11 switches straight away, without opening this window."/>
    </StackPanel>
</Window>
