<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ScreenSwitcher</RootNamespace>
    <AssemblyName>ScreenSwitcher</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>Screen Switcher</Product>
    <AssemblyTitle>Screen Switcher</AssemblyTitle>
    <Version>1.0.0</Version>

    <!-- One .exe that uses the .NET already on this PC; keeps working on a newer .NET if 9 is removed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>

    <!-- Application.ThemeMode (Fluent dark theme) is flagged experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
