<Application x:Class="ScreenSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#14171C"/>
        <SolidColorBrush x:Key="TextMain" Color="#E7EBF1"/>
        <SolidColorBrush x:Key="TextDim" Color="#98A3B3"/>

        <SolidColorBrush x:Key="CardBg" Color="#262D38"/>
        <SolidColorBrush x:Key="CardHover" Color="#2F3846"/>
        <SolidColorBrush x:Key="CardBorder" Color="#3A4453"/>
        <SolidColorBrush x:Key="CardActive" Color="#1D3A5C"/>

        <SolidColorBrush x:Key="Accent" Color="#55A8FF"/>
        <SolidColorBrush x:Key="StateFailed" Color="#F0555A"/>
    </Application.Resources>
</Application>
